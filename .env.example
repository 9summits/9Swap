# Copy to .env to enable key-gated venues. Venues without a key are skipped
# under -v all (stderr names the missing env vars); querying them directly
# (-v matcha / -v 1inch) raises a MissingApiKeyError with the signup URL.

# https://dashboard.0x.org (Matcha / 0x Swap API)
ZEROEX_API_KEY=

# https://portal.1inch.dev (also used by 1inch Fusion via -v fusion --allow-async)
ONEINCH_API_KEY=

# https://hub.uniswap.org (UniswapX trading API; only needed for -v uniswapx)
UNISWAP_API_KEY=

# Required for CLI -d/--data, --simulate, and --browser. Single key covers
# every chain the CLI supports (eth / arb / base / avax / hype). Sign up at
# https://dashboard.alchemy.com — free tier is enough for occasional lookups.
# The interactive dApp can run without this key and last-resorts to PublicNode.
ALCHEMY_API_KEY=

# Optional per-chain overrides. Skip Alchemy for this chain and use the given
# endpoint directly (e.g. a private RPC, a node you run yourself). Either
# naming convention works; RPC_URL_<chainId> takes precedence.
# ETH_RPC_URL=
# ARB_RPC_URL=
# BASE_RPC_URL=
# AVAX_RPC_URL=
# HYPE_RPC_URL=
# RPC_URL_1=

# Default sender address for tx build when --from is not passed.
# SENDER_ADDRESS=

# https://cloud.reown.com (ex-WalletConnect Cloud) — free Project ID (32-char
# hex). Enables WalletConnect in the dApp's RainbowKit modal; without it only
# injected/extension wallets are offered. Add localhost + your deploy domain to
# the project's Allowed Domains to silence the origin warning.
WALLETCONNECT_PROJECT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Referral / partner fees
#
# All five venues support permissionless attribution. If REFERRAL_ADDRESS is
# unset, no fees are charged anywhere. If set:
#   - velora: takeSurplus=true is enabled (skims positive slippage to your
#     address — invisible to the user, doesn't worsen the displayed quote).
#   - matcha (0x): tradeSurplusRecipient is set to REFERRAL_ADDRESS (same
#     surplus idea; honored only once 0x enables it on your API key).
#   - kyber: sends the feeReceiver quartet even at 0 bps (feeAmount=0,
#     isInBps=true, chargeFeeBy=currency_out) so the receiver is registered.
#     Kyber's docs still say they keep positive slippage.
#   - other venues: fee is only charged when REFERRAL_FEE_BPS > 0.
# REFERRAL_FEE_BPS is the *additional explicit fee* layered on top, in basis
# points (1 bp = 0.01%). Capped at 1000 (10%). Each venue further clamps to
# its own ceiling: 0x 1000 bps (docs.0x.org/evm/0x-swap-api/guides/
# monetize-your-app-using-swap: "swapFeeBps has a default limit of 1000 Bps
# for security"), 1inch 300 bps (rejects >3% with a hard 400), OpenOcean
# 500 bps (their own documented cap). Default 0.
#
REFERRAL_ADDRESS=
REFERRAL_FEE_BPS=

# 1inch Fusion integrator fee is per-key and off by default: 1inch answers a
# hard 400 to any non-zero fee until they enable it on your ONEINCH_API_KEY.
# Set to 1 once enabled; until then fusion only sends `source` attribution.
# FUSION_FEE_ENABLED=1

# Attribution label (velora `partner`, kyber `x-client-id`, fusion `source`,
# cow `appCode`). Three channels, one value each: the public binary bakes
# `REFERRAL_NAME=swap` into `.env.install`, the hosted dApp sets its own value
# in the Vercel project env, and a self-host reads this file. Unset defaults to
# `swap-selfhost`. The process then appends `-cli`, `-dapp`, or `-browser`, so
# the wire carries e.g. `swap-cli` / `swap-dapp` for the public binary and
# `swap-selfhost-cli` for an unconfigured self-host.
# REFERRAL_NAME=swap

# KyberSwap (optional — every knob unset = public keyless host, unchanged).
#   KYBER_API_KEY   — X-Api-Key for the API gateway. Issued by KyberSwap BD
#                     (business@kyber.network). Higher limits than the public
#                     host (3 rps). Setting it is enough: the adapter already
#                     switches the base to https://api.kyberswap.com/swap.
#                     Unset → https://aggregator-api.kyberswap.com (no key).
#   KYBER_API_BASE  — leave unset. Only if you must hit a host other than the
#                     two defaults above (no trailing slash). Do not set this
#                     to https://api.kyberswap.com/swap — that is already the
#                     default whenever KYBER_API_KEY is set. A gateway URL
#                     without a key is ignored (would 401).
#   KYBER_SOURCE    — free-form `source` sent on /route/build, recorded on-chain
#                     in the router's ClientData event (may differ from the
#                     x-client-id label, which is REFERRAL_NAME). No signup.
#   KYBER_REFERRAL  — free-form `referral` code on /route/build, also written to
#                     ClientData. Attribution only, no payout behind it. No signup.
# KYBER_API_KEY=
# KYBER_API_BASE=
# KYBER_SOURCE=swap
# KYBER_REFERRAL=

# Odos API V3 monetization: fees are honored only on the enterprise
# endpoint (https://enterprise-api.odos.xyz). Set ODOS_API_KEY to your
# Odos enterprise key to (a) route through enterprise-api.odos.xyz with
# Bearer auth and (b) actually collect REFERRAL_FEE_BPS / REFERRAL_ADDRESS.
# When unset, the adapter uses the free public api.odos.xyz endpoint
# which silently ignores partnerFeePercent / feeRecipient.
ODOS_API_KEY=
#
# Odos legacy V2 (`-v odosv2`) — registered referral code applied as
# `referralCode` on /sor/quote/v2. V3 (`-v odos`) ignores this var.
# ODOS_REFERRAL_CODE=

# CoW Swap (`-v cow`) affiliate code. Embedded as metadata.referrer.code
# (+ appCode = REFERRAL_NAME). Case-insensitive, stored uppercase; must match
# ^[A-Z0-9_-]{5,20}$. Attribution only, survives --nofee. Volume partner fees
# are metadata.partnerFee from REFERRAL_ADDRESS / REFERRAL_FEE_BPS (clamped
# to CoW's 100 bps ceiling).
# COW_REFERRAL_CODE=

# Ophis (`-v ophis --allow-async`) referral code — Ophis is a CoW Protocol fork
# that pays a monthly WETH rebate per order tagged with your code. Embedded in
# the order's appData as `metadata.ophisReferrer.code` (appCode stays "ophis").
# Case-SENSITIVE, stored verbatim. Also gates the venue: unset → Ophis is
# skipped in -v all (it'd otherwise be CoW + an unrebated fee). The Ophis CIP-75
# partner fee (5 bps partner rate, 1 bp stable — sdk 0.2.3) is applied on served
# chains regardless and is already netted into the quoted output. Served here:
# eth/arb/base/bsc/avax/unichain (unichain settles on Ophis's own contracts).
# OPHIS_REFERRAL_CODE=

# OpenOcean is keyless on the public host (2 rps). Set OPENOCEAN_API_KEY to
# switch to the enterprise host (https://open-api-enterprise.openocean.finance,
# `apikey` header). Apply at
# https://docs.openocean.finance/docs/swap-api/enterprise.
# Partner fees: REFERRAL_ADDRESS + REFERRAL_FEE_BPS are forwarded as
# `referrer` / `referrerFee` on /swap; OpenOcean caps the fee at
# 500 bps (5%), so anything higher is clamped before sending.
# OPENOCEAN_API_KEY=

# ── Hosted / local dApp server ──
#
# SWAP_SID — pins the dApp session token so the access link
# (https://your-host/?id=<SWAP_SID>) survives restarts. The
# link IS the credential: generate a long random value (e.g.
# `openssl rand -hex 16`) and keep it secret. Unset = a fresh random
# sid per start (printed on stderr), fine for local `swap` usage.
SWAP_SID=
#
# SWAP_HOST — bind address of the dApp server. Defaults to 127.0.0.1
# (loopback only). Set 0.0.0.0 to listen on all interfaces; never expose
# 5151 directly to the internet.
# SWAP_HOST=0.0.0.0
#
# SWAP_NO_AUTH — set to 1 to disable the ?id= session gate entirely
# (clean URLs). Anyone who can reach the server can then use it: only
# enable behind another lock (VPN, IP allowlist, reverse-proxy auth).
# Takes precedence over SWAP_SID.
# SWAP_NO_AUTH=1
#
# SWAP_DISABLE_VENUES — CSV of venue names to exclude everywhere
# (quotes, builds, /api/mode). Mandatory on a Vercel deployment: set
# to `curve` — curve-js's ~12 s in-process init is incompatible with
# serverless cold starts (see docs/vercel.md).
# SWAP_DISABLE_VENUES=curve
#
# NO_BROWSER_OPEN — set to 1 to stop `--browser` and the no-args dApp
# mode from auto-opening the OS browser; the session URL is still
# printed on stderr. Useful for headless / CI / SSH sessions.
# NO_BROWSER_OPEN=1
